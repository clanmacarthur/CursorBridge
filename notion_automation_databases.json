      "description": "Core technique library with lens-specific explanation templates - enables multi-paradigm session generation",
      "properties": {
        "Technique": {"type": "title"},
        "Technique Category": {"type": "select", "options": ["Breath", "Movement", "Somatic", "Meditation/NSDR", "Tapping", "Cognitive", "Ritual"]},
        "Objective": {"type": "multi_select", "options": ["Downshift Arousal", "Increase Energy", "Improve Sleep", "Reduce Anxiety", "Improve Focus", "Release Tension", "Pain Modulation", "Emotional Processing"]},
        "Primary Intent": {"type": "relation", "database": "Attribute Taxonomy (DB)", "direction": "<->", "limit": "L1"},
        "Secondary Intents": {"type": "relation", "database": "Attribute Taxonomy (DB)", "direction": "<->", "limit": "NL"},
        "Lens Availability": {"type": "multi_select", "options": ["Western", "TCM", "Hybrid"]},
