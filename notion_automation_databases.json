  "databases": [
    {
      "id": "evidence_sources",
      "title": "Evidence Sources (DB)",
      "icon": "📚",
      "description": "Research, guidelines, and traditional references supporting techniques - enables evidence-based explanations",
      "properties": {
        "Evidence Source": {"type": "title"},
        "Evidence Type": {"type": "select", "options": ["Systematic Review", "Meta-analysis", "RCT", "Observational", "Mechanistic", "Clinical Guideline", "Traditional/Lineage", "Expert Consensus"]},
        "Primary Domain": {"type": "relation", "database": "Attribute Taxonomy (DB)", "direction": "->", "limit": "L1"},
        "Secondary Domains": {"type": "relation", "database": "Attribute Taxonomy (DB)", "direction": "->", "limit": "NL"},
        "Applies To Techniques": {"type": "relation", "database": "Techniques (DB)", "direction": "<->", "limit": "NL"},
        "Applies To Protocols": {"type": "relation", "database": "Nutrition Protocols (DB)", "direction": "<->", "limit": "NL"},
        "Applies To Supplement Interactions": {"type": "relation", "database": "Supplement Interactions (DB)", "direction": "<->", "limit": "NL"},
        "Lens Tags": {"type": "multi_select", "options": ["Western", "TCM", "Hybrid", "Somatic", "Breathwork", "Movement", "Sleep"]},
        "Citation (APA short)": {"type": "text"},
        "DOI / URL": {"type": "url"},
        "Year": {"type": "number"},
        "Author / Organisation": {"type": "text"},
        "Key Claims Summary": {"type": "text"},
        "Evidence Confidence": {"type": "select", "options": ["Strong", "Moderate", "Emerging", "Traditional"]},
        "Review State": {"type": "select", "options": ["Unreviewed", "In Review", "Verified", "Disputed", "Deprecated"]},
        "Verified By": {"type": "relation", "database": "Professional Profiles (DB)", "direction": "->", "limit": "L1"},
        "Verification Notes": {"type": "text"},
        "Last Reviewed Date": {"type": "date"},
        "Notes": {"type": "text"}
      }
    },
    {
      "id": "techniques",
      "title": "Techniques (DB)",
