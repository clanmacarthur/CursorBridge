        "Function Type": {"type": "select", "options": ["Linear", "Threshold", "Conditional", "Decay", "Inverse", "Step"]},
        "Direction": {"type": "select", "options": ["Positive", "Negative", "Conditional"]},
        "Magnitude": {"type": "number"},
        "Threshold Value": {"type": "number"},
        "Threshold Comparator": {"type": "select", "options": [">=", "<=", "=", "Between", "Above", "Below"]},
        "Applies To Profiles": {"type": "relation", "database": "Programme Profiles (DB)", "limit": "NL"},
        "Priority": {"type": "number"},
        "Evidence Confidence": {"type": "select", "options": ["Strong", "Moderate", "Emerging", "Traditional"]},
        "Status": {"type": "select", "options": ["Active", "Deprecated", "Archived"]},
        "Notes": {"type": "text"}
      }
    },
    {
      "id": "derived_metrics",
      "title": "Derived Metrics (DB)",
