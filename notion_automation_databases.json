        "Contraindications Summary": {"type": "relation", "database": "Safety Rules (DB)", "direction": "<->", "limit": "NL"},
        "Required Inputs": {"type": "multi_select", "options": ["Duration", "Intensity", "Experience Level", "Contraindications Check", "Environment"]},
        "Default Duration (min)": {"type": "number"},
        "Intensity Band": {"type": "select", "options": ["Low", "Medium", "High"]},
        "Session Compatibility": {"type": "relation", "database": "Session Templates (DB)", "direction": "<->", "limit": "NL"},
        "Evidence Sources": {"type": "relation", "database": "Evidence Sources (DB)", "direction": "<->", "limit": "NL"},
        "Notes": {"type": "text"}
      }
    },
