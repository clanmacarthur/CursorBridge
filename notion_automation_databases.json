        "Output Max": {"type": "number"},
        "Unit": {"type": "text"},
        "Threshold Low": {"type": "number"},
        "Threshold Medium": {"type": "number"},
        "Threshold High": {"type": "number"},
        "Domain": {"type": "select", "options": ["Recovery", "Sleep Quality", "Nutrition Quality", "Stress Load", "Energy", "Focus", "Mood"]},
        "Status": {"type": "select", "options": ["Active", "Deprecated", "Archived"]},
        "Notes": {"type": "text"}
      }
    },
    {
      "id": "questionnaires",
      "title": "Questionnaires (DB)",
      "icon": "📝",
      "description": "Questionnaire definitions for profile assignment",
      "properties": {
        "Questionnaire Name": {"type": "title"},
        "Questionnaire Slug": {"type": "text"},
        "Description": {"type": "text"},
